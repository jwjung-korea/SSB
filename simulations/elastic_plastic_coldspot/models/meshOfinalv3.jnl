    mdb.models['Lithium_Model_p10'].parts['LITHIUM_PART'].edges.getSequenceFromMask(
    mask=('[#8 ]', ), ), number=25, ratio=5.0)
mdb.models['Lithium_Model_p10'].parts['LITHIUM_PART'].seedEdgeByBias(
    biasMethod=SINGLE, constraint=FINER, end2Edges=
    mdb.models['Lithium_Model_p10'].parts['LITHIUM_PART'].edges.getSequenceFromMask(
    mask=('[#2 ]', ), ), number=25, ratio=5.0)
mdb.models['Lithium_Model_p10'].parts['LLZO_PART'].setMeshControls(elemShape=
    QUAD, regions=mdb.models['Lithium_Model_p10'].parts['LLZO_PART'].faces, 
    technique=STRUCTURED)
mdb.models['Lithium_Model_p10'].parts['LITHIUM_PART'].setMeshControls(
    elemShape=QUAD, regions=
    mdb.models['Lithium_Model_p10'].parts['LITHIUM_PART'].faces, technique=
    STRUCTURED)
mdb.models['Lithium_Model_p10'].parts['LLZO_PART'].generateMesh()
mdb.models['Lithium_Model_p10'].parts['LITHIUM_PART'].generateMesh()
mdb.models['Lithium_Model_p10'].rootAssembly.regenerate()
mdb.Job(description=
    'Modified Lithium/LLZO model with quadratic CPE8H elements and contact friction 0.1, pressure 10.0'
    , model='Lithium_Model_p10', name='final_v2_p10', resultsFormat=ODB, type=
    ANALYSIS, userSubroutine=
    'C:/Abaqus_Work/lithium_electrodeposition/elastic_plastic_coldspot/umat_EP_coldspot.for')
