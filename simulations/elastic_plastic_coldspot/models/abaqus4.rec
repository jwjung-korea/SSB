# -*- coding: mbcs -*-
from part import *
from material import *
from section import *
from assembly import *
from step import *
from interaction import *
from load import *
from mesh import *
from job import *
from sketch import *
mdb.Model(name='Lithium_Model')
mdb.models['Lithium_Model'].Material(name='LITHIUM_IP')
mdb.models['Lithium_Model'].materials['LITHIUM_IP'].UserMaterial(
    mechanicalConstants=(7200.0, 0.38, 3.1, 5.7, 2.0, 2.0, 1.3e-05, 0.0, 1.0, 
    0.0, 103.643), type=MECHANICAL)
mdb.models['Lithium_Model'].materials['LITHIUM_IP'].Depvar(n=24)
mdb.models['Lithium_Model'].Material(name='LITHIUM_SUB')
mdb.models['Lithium_Model'].materials['LITHIUM_SUB'].UserMaterial(
    mechanicalConstants=(7200.0, 0.38, 3.1, 5.7, 2.0, 2.0, 1.3e-05, 0.0, 1.0, 
    0.0, 0.0), type=MECHANICAL)
mdb.models['Lithium_Model'].materials['LITHIUM_SUB'].Depvar(n=24)
mdb.models['Lithium_Model'].Material(name='LLZO')
mdb.models['Lithium_Model'].materials['LLZO'].Elastic(table=((150000.0, 0.25), 
    ))
mdb.models['Lithium_Model'].HomogeneousSolidSection(material='LLZO', name=
    'SEC_LLZO', thickness=None)
mdb.models['Lithium_Model'].HomogeneousSolidSection(material='LITHIUM_IP', 
    name='SEC_SEED', thickness=None)
mdb.models['Lithium_Model'].HomogeneousSolidSection(material='LITHIUM_SUB', 
    name='SEC_LITHIUM', thickness=None)
mdb.models['Lithium_Model'].ConstrainedSketch(name='__profile__', sheetSize=
    100.0)
mdb.models['Lithium_Model'].sketches['__profile__'].rectangle(point1=(0.0, 0.0)
    , point2=(20.0, 5.0))
mdb.models['Lithium_Model'].Part(dimensionality=TWO_D_PLANAR, name='LLZO_PART', 
    type=DEFORMABLE_BODY)
mdb.models['Lithium_Model'].parts['LLZO_PART'].BaseShell(sketch=
    mdb.models['Lithium_Model'].sketches['__profile__'])
mdb.models['Lithium_Model'].parts['LLZO_PART'].SectionAssignment(region=Region(
    faces=mdb.models['Lithium_Model'].parts['LLZO_PART'].faces.getSequenceFromMask(
    mask=('[#1 ]', ), )), sectionName='SEC_LLZO')
mdb.models['Lithium_Model'].ConstrainedSketch(name='__profile__', sheetSize=
    100.0)
mdb.models['Lithium_Model'].sketches['__profile__'].rectangle(point1=(0.0, 5.0)
    , point2=(20.0, 10.5))
mdb.models['Lithium_Model'].Part(dimensionality=TWO_D_PLANAR, name=
    'LITHIUM_PART', type=DEFORMABLE_BODY)
mdb.models['Lithium_Model'].parts['LITHIUM_PART'].BaseShell(sketch=
    mdb.models['Lithium_Model'].sketches['__profile__'])
mdb.models['Lithium_Model'].parts['LITHIUM_PART'].PartitionFaceByShortestPath(
    faces=mdb.models['Lithium_Model'].parts['LITHIUM_PART'].faces, point1=(0.0, 
    5.5, 0.0), point2=(20.0, 5.5, 0.0))
mdb.models['Lithium_Model'].parts['LITHIUM_PART'].SectionAssignment(region=
    Region(
    faces=mdb.models['Lithium_Model'].parts['LITHIUM_PART'].faces.getSequenceFromMask(
    mask=('[#2 ]', ), )), sectionName='SEC_SEED')
mdb.models['Lithium_Model'].parts['LITHIUM_PART'].SectionAssignment(region=
    Region(
    faces=mdb.models['Lithium_Model'].parts['LITHIUM_PART'].faces.getSequenceFromMask(
    mask=('[#1 ]', ), )), sectionName='SEC_LITHIUM')
mdb.models['Lithium_Model'].rootAssembly.Instance(dependent=OFF, name=
    'LLZO_INST', part=mdb.models['Lithium_Model'].parts['LLZO_PART'])
mdb.models['Lithium_Model'].rootAssembly.Instance(dependent=OFF, name=
    'LITHIUM_INST', part=mdb.models['Lithium_Model'].parts['LITHIUM_PART'])
mdb.models['Lithium_Model'].rootAssembly.Set(edges=
    mdb.models['Lithium_Model'].rootAssembly.instances['LLZO_INST'].edges.getSequenceFromMask(
    mask=('[#1 ]', ), ), name='BOTTOM')
mdb.models['Lithium_Model'].rootAssembly.Set(edges=
    mdb.models['Lithium_Model'].rootAssembly.instances['LLZO_INST'].edges.getSequenceFromMask(
    mask=('[#8 ]', ), )+\
    mdb.models['Lithium_Model'].rootAssembly.instances['LITHIUM_INST'].edges.getSequenceFromMask(
    mask=('[#18 ]', ), ), name='LEFT')
mdb.models['Lithium_Model'].rootAssembly.Set(edges=
    mdb.models['Lithium_Model'].rootAssembly.instances['LLZO_INST'].edges.getSequenceFromMask(
    mask=('[#2 ]', ), )+\
    mdb.models['Lithium_Model'].rootAssembly.instances['LITHIUM_INST'].edges.getSequenceFromMask(
    mask=('[#42 ]', ), ), name='RIGHT')
mdb.models['Lithium_Model'].rootAssembly.Surface(name='TOP_SURFACE', 
    side1Edges=
    mdb.models['Lithium_Model'].rootAssembly.instances['LITHIUM_INST'].edges.getSequenceFromMask(
    mask=('[#4 ]', ), ))
mdb.models['Lithium_Model'].rootAssembly.Surface(name='LLZO_TOP_SURF', 
    side1Edges=
    mdb.models['Lithium_Model'].rootAssembly.instances['LLZO_INST'].edges.getSequenceFromMask(
    mask=('[#4 ]', ), ))
mdb.models['Lithium_Model'].rootAssembly.Surface(name='LITHIUM_BOT_SURF', 
    side1Edges=
    mdb.models['Lithium_Model'].rootAssembly.instances['LITHIUM_INST'].edges.getSequenceFromMask(
    mask=('[#20 ]', ), ))
mdb.models['Lithium_Model'].rootAssembly.Set(faces=
    mdb.models['Lithium_Model'].rootAssembly.instances['LITHIUM_INST'].faces, 
    name='LITHIUM_NODES_SET')
mdb.models['Lithium_Model'].ContactProperty('IntProp-1')
mdb.models['Lithium_Model'].interactionProperties['IntProp-1'].TangentialBehavior(
    dependencies=0, directionality=ISOTROPIC, formulation=PENALTY, fraction=
    0.005, maximumElasticSlip=FRACTION, pressureDependency=OFF, 
    slipRateDependency=OFF, table=((0.1, ), ), temperatureDependency=OFF)
mdb.models['Lithium_Model'].interactionProperties['IntProp-1'].NormalBehavior(
    allowSeparation=ON, pressureOverclosure=HARD)
mdb.models['Lithium_Model'].SurfaceToSurfaceContactStd(createStepName='Initial'
    , interactionProperty='IntProp-1', master=
    mdb.models['Lithium_Model'].rootAssembly.surfaces['LLZO_TOP_SURF'], name=
    'Int-1', slave=
    mdb.models['Lithium_Model'].rootAssembly.surfaces['LITHIUM_BOT_SURF'], 
    sliding=FINITE)
mdb.models['Lithium_Model'].StaticStep(initialInc=0.001, maxInc=1.0, maxNumInc=
    100000, minInc=1e-07, name='Step-1', nlgeom=ON, previous='Initial', 
    stabilizationMagnitude=0.002, stabilizationMethod=DAMPING_FACTOR, 
    timePeriod=21600.0)
mdb.models['Lithium_Model'].DisplacementBC(createStepName='Initial', name=
    'BC_BOT', region=mdb.models['Lithium_Model'].rootAssembly.sets['BOTTOM'], 
    u1=0.0, u2=0.0)
mdb.models['Lithium_Model'].DisplacementBC(createStepName='Initial', name=
    'BC_LEFT', region=mdb.models['Lithium_Model'].rootAssembly.sets['LEFT'], 
    u1=0.0)
mdb.models['Lithium_Model'].DisplacementBC(createStepName='Initial', name=
    'BC_RIGHT', region=mdb.models['Lithium_Model'].rootAssembly.sets['RIGHT'], 
    u1=0.0)
mdb.models['Lithium_Model'].Temperature(createStepName='Initial', 
    crossSectionDistribution=CONSTANT_THROUGH_THICKNESS, distributionType=
    UNIFORM, magnitudes=(0.0, ), name='Predef_Temp', region=
    mdb.models['Lithium_Model'].rootAssembly.sets['LITHIUM_NODES_SET'])
mdb.models['Lithium_Model'].Pressure(createStepName='Step-1', magnitude=1.0, 
    name='Load-1', region=
    mdb.models['Lithium_Model'].rootAssembly.surfaces['TOP_SURFACE'])
mdb.models['Lithium_Model'].FieldOutputRequest(createStepName='Step-1', name=
    'F-Output-1', variables=('S', 'U', 'RF', 'LE', 'SDV', 'STATUS', 'NT'))
